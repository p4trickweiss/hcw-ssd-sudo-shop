{
	"name": "hcw-ssd-sudo-shop",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node --env-file=.env node_modules/vite/bin/vite.js --host 127.0.0.1 --port 4173 --strictPort",
		"build": "vite build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write src scripts vite.config.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.4",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.4",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@lucide/svelte": "^1.67.0",
		"clsx": "^2.1.1",
		"pg": "^8.23.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.1",
		"zod": "^4.6.7"
	},
	"engines": {
		"node": ">=22.18.0",
		"pnpm": ">=12"
	}
}
